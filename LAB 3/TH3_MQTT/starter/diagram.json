{
  "version": 1,
  "author": "CE339 - Lab TH3 MQTT",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-potentiometer", "id": "pot1", "top": -110, "left": -150, "attrs": { "value": "1000" } },
    { "type": "wokwi-led", "id": "led1", "top": -60, "left": 190, "attrs": { "color": "green" } },
    { "type": "wokwi-resistor", "id": "r1", "top": 20, "left": 170, "rotate": 90, "attrs": { "value": "220" } },
    { "type": "wokwi-pushbutton", "id": "btnHang", "top": 150, "left": 190, "attrs": { "color": "red", "label": "HANG" } },
    { "type": "wokwi-pushbutton", "id": "btnDisc", "top": 230, "left": 190, "attrs": { "color": "blue", "label": "DISC" } }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],
    [ "pot1:VCC", "esp:3V3", "red", [] ],
    [ "pot1:GND", "esp:GND.1", "black", [] ],
    [ "pot1:SIG", "esp:34", "green", [] ],
    [ "esp:26", "r1:1", "orange", [] ],
    [ "r1:2", "led1:A", "orange", [] ],
    [ "led1:C", "esp:GND.2", "black", [] ],
    [ "btnHang:1.l", "esp:18", "red", [] ],
    [ "btnHang:2.l", "esp:GND.2", "black", [] ],
    [ "btnDisc:1.l", "esp:19", "blue", [] ],
    [ "btnDisc:2.l", "esp:GND.2", "black", [] ]
  ],
  "dependencies": {}
}
