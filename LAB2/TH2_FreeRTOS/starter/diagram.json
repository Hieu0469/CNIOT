{
  "version": 1,
  "author": "CE339 - Lab TH2",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-pushbutton", "id": "btn1", "top": 60, "left": 220, "attrs": { "color": "red", "label": "TREO" } },
    { "type": "wokwi-led", "id": "led1", "top": -80, "left": 230, "attrs": { "color": "green" } },
    { "type": "wokwi-resistor", "id": "r1", "top": -10, "left": 180, "rotate": 90, "attrs": { "value": "220" } },
    { "type": "wokwi-logic-analyzer", "id": "logic1", "top": 200, "left": 220, "attrs": {} }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],
    [ "btn1:1.l", "esp:4", "green", [] ],
    [ "btn1:2.l", "esp:GND.2", "black", [] ],
    [ "esp:2", "r1:1", "orange", [] ],
    [ "r1:2", "led1:A", "orange", [] ],
    [ "led1:C", "esp:GND.3", "black", [] ],
    [ "logic1:D0", "esp:18", "blue", [] ],
    [ "logic1:D1", "esp:19", "violet", [] ],
    [ "logic1:D2", "esp:23", "gold", [] ],
    [ "logic1:D3", "esp:25", "gray", [] ],
    [ "logic1:GND", "esp:GND.1", "black", [] ]
  ],
  "dependencies": {}
}
